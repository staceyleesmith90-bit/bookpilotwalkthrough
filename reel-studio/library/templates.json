{
  "day-in-my-life": {
    "name": "A Day In My Life",
    "category": "Lifestyle",
    "format": "voiceover",
    "length": "20-35s",
    "why": "The most-copied vlog format: soft title, time stamps and cosy b-roll make people feel they're with you.",
    "film": [
      "Morning light / opening the curtains",
      "Coffee or breakfast being made",
      "You working (laptop, hands)",
      "An outside moment (walk, errands)",
      "Evening wind-down (candle, book, couch)"
    ],
    "script": "One short line per clip, like a diary: '6:30 \u2014 the house is still quiet'.",
    "title": {
      "template": "with-me",
      "title": "A Day With Me",
      "kicker": "mini vlog",
      "sub": "{date}"
    },
    "beats": [
      "title",
      "label:{time}",
      "label:{time}",
      "label:{time}",
      "label:{time}"
    ],
    "captions": "elegant",
    "grade": "latte",
    "transition": "dip-white",
    "zoom": "push",
    "stickers": "few, thin doodles or 3D emoji",
    "music": {
      "mood": [
        "cosy"
      ],
      "genre": [
        "lo-fi"
      ],
      "tempo": "slow"
    }
  },
